{
  "name": "@finance-os/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed, typed client",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test/postgres.ts",
    "./seed": "./src/seed/seed-demo.ts",
    "./seed-data": "./src/seed/data.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "@testcontainers/postgresql": "^12.2.1",
    "argon2": "^0.45.2",
    "prisma": "7.10.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@finance-os/config": "workspace:*",
    "@finance-os/shared": "workspace:*",
    "@finance-os/stellar": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^18.0.9",
    "pg": "^8.23.1"
  }
}
